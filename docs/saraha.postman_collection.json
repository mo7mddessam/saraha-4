{
  "info": {
    "name": "Saraha App",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Signup",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/signup"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Ahmed\",\n  \"lastName\": \"Ali\",\n  \"email\": \"ahmed@test.com\",\n  \"password\": \"Pass1234\",\n  \"confirmPassword\": \"Pass1234\",\n  \"phone\": \"01012345678\",\n  \"gender\": \"male\"\n}"
        }
      }
    },
    {
      "name": "Confirm email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/confirm-email"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ahmed@test.com\",\n  \"otp\": \"123456\"\n}"
        }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ahmed@test.com\",\n  \"password\": \"Pass1234\"\n}"
        }
      }
    },
    {
      "name": "Forgot password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/forgot-password"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ahmed@test.com\"\n}"
        }
      }
    },
    {
      "name": "Reset password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/reset-password"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ahmed@test.com\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"NewPass123\",\n  \"confirmPassword\": \"NewPass123\"\n}"
        }
      }
    },
    {
      "name": "My profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/profile"
        }
      }
    },
    {
      "name": "Update profile",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/profile"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Ahmed\"\n}"
        }
      }
    },
    {
      "name": "Upload picture",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/profile/picture"
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "image",
              "type": "file"
            }
          ]
        }
      }
    },
    {
      "name": "Change password",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/password"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"oldPassword\": \"Pass1234\",\n  \"newPassword\": \"NewPass123\",\n  \"confirmPassword\": \"NewPass123\"\n}"
        }
      }
    },
    {
      "name": "Freeze account",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/freeze"
        }
      }
    },
    {
      "name": "Public profile",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users/{{userId}}"
        }
      }
    },
    {
      "name": "Send anonymous message",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/messages/{{userId}}"
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "content",
              "value": "I like your work!",
              "type": "text"
            },
            {
              "key": "attachments",
              "type": "file"
            }
          ]
        }
      }
    },
    {
      "name": "My messages",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/messages?page=1&limit=10"
        }
      }
    },
    {
      "name": "Get message",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/messages/{{messageId}}"
        }
      }
    },
    {
      "name": "Delete message",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/messages/{{messageId}}"
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "messageId",
      "value": ""
    }
  ]
}